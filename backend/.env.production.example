# Modelo de variáveis de ambiente para PRODUÇÃO, usado pelo docker-compose.yml.
# Copie para ".env" na mesma pasta e preencha os valores reais antes de subir
# os contêineres. NUNCA reaproveite os valores do .env de bancada aqui —
# veja o checklist de segredos para saber exatamente o que precisa ser novo.

# --- Banco de dados (serviço "db" do docker-compose) ---
POSTGRES_DB=eco_auth
POSTGRES_USER=eco_auth
POSTGRES_PASSWORD=

# --- MK-AUTH ---
MKAUTH_MODE=real
MKAUTH_BASE_URL=https://SEU-DOMINIO-MKAUTH
MKAUTH_CLIENT_ID=
MKAUTH_CLIENT_SECRET=
MKAUTH_VERIFY_SSL=true
MKAUTH_ALLOW_HTTP=false
MKAUTH_WRITES_ENABLED=true

# --- MikroTik / RouterOS ---
ROUTEROS_MODE=real
ROUTEROS_HOST=
ROUTEROS_PORT=8728
ROUTEROS_USERNAME=
ROUTEROS_PASSWORD=

# --- OLT (deixe simulated até o hardware estar pronto) ---
OLT_MODE=simulated

# --- Segurança — gere valores novos, nunca reaproveite os de bancada ---
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Opcional — se vazio, o sistema usa o JWT_SECRET para criptografar os
# segredos de integração também. Definir uma chave separada aqui é mais
# seguro (se um vazar, o outro continua protegido).
INTEGRATION_ENCRYPTION_KEY=

# --- Login da Central (por provedor) ---
CENTRAL_USERNAME=
CENTRAL_PASSWORD=

# --- Login da plataforma (administração de todos os provedores) ---
PLATFORM_ADMIN_USERNAME=
PLATFORM_ADMIN_PASSWORD=

# --- Login de bancada do técnico (times de teste; cada técnico real tem seu próprio usuário) ---
TECHNICIAN_USERNAME=
TECHNICIAN_PASSWORD=
